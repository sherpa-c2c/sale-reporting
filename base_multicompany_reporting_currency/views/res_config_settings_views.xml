<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='inter_company']" position="after">
                <setting string="Multicompany Reporting Currency" help="Set multicompany reporting currency" groups="base.group_no_one">
                    <field name="multicompany_reporting_currency" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
